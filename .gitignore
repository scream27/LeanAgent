# Local upstream checkouts and centrally managed build links
/sources/
__pycache__/
*.pyc
.DS_Store
*.egg-info
/build
/dist
.env
/configs/*.local.json
/runs/first-harness/

# Versioned large data is distributed separately; metadata remains reviewable.
/data/**/*.gz
/data/corpora/**/context-index.json
/benchmarks/arena/**/app.py
/benchmarks/arena/**/benchmark.py
/benchmarks/arena/**/*.jsonl
/runs/**/*.jsonl
/runs/**/*.gz

# No expanded inputs or restored legacy workspaces inside the repository.
/artifacts/
/runs/corpus-survey/all_sources/summary.json
/runs/corpus-survey/tactic_comparison/summary.json
